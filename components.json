{
  "version": 1,
  "domain": "somosgreenstock.mx",
  "pageId": "allPages",
  "components": [
    {
      "id": "skipToMainLink",
      "type": "button",
      "config": {
        "type": "button",
        "label": "Saltar al contenido principal",
        "ariaControls": "main-content",
        "classes": "skipLink",
        "styles": {
          "display": "inline-flex",
          "alignItems": "center",
          "boxSizing": "border-box",
          "minHeight": "48px",
          "fontSize": "14px",
          "fontFamily": "inherit",
          "cursor": "pointer",
          "border": "0"
        }
      },
      "eventInstructions": "skipToMain:main-content"
    },
    {
      "id": "siteHeader",
      "type": "container",
      "config": {
        "tag": "header",
        "classes": "siteHeader",
        "styles": {
          "fontFamily": "Montserrat, Arial, sans-serif",
          "display": "flex",
          "justifyContent": "center",
          "width": "100%",
          "boxSizing": "border-box",
          "paddingInline": "20px"
        },
        "components": [
          "headerShell"
        ]
      }
    },
    {
      "id": "headerShell",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "headerShell",
        "components": [
          "brandHomeLink",
          "siteNav",
          "headerOrderCta"
        ],
        "styles": {
          "display": "flex",
          "alignItems": "center",
          "justifyContent": "space-between",
          "width": "100%",
          "maxWidth": "1180px",
          "minHeight": "88px",
          "boxSizing": "border-box",
          "paddingBlock": "4px",
          "columnGap": "12px",
          "rowGap": "0",
          "flexWrap": "wrap"
        }
      }
    },
    {
      "id": "brandHomeLink",
      "type": "link",
      "config": {
        "href": "/",
        "text": "",
        "ariaLabel": "Greenstock, ir al inicio",
        "classes": "brandHomeLink ank-order-1",
        "components": [
          "headerLogo"
        ],
        "styles": {
          "display": "inline-flex",
          "alignItems": "center",
          "justifyContent": "center",
          "boxSizing": "border-box",
          "minHeight": "48px",
          "width": "fit-content",
          "maxWidth": "100%",
          "alignSelf": "center",
          "justifySelf": "start"
        }
      }
    },
    {
      "id": "headerLogo",
      "type": "media",
      "valueInstructions": "set:config.src,var,brand.logoUrl;set:config.alt,i18n,ui.logoAlt",
      "config": {
        "tag": "image",
        "src": "https://assets.zoolandingpage.com.mx/somosgreenstock.mx/shared/logos/greenstock-wordmark-primary.png",
        "alt": "Greenstock",
        "width": 1600,
        "height": 1600,
        "loading": "eager",
        "decoding": "async",
        "fetchPriority": "low",
        "classes": "headerLogo",
        "styles": {
          "display": "block",
          "backgroundColor": "var(--ank-bgColor)",
          "objectFit": "contain",
          "width": "64px",
          "height": "64px"
        }
      }
    },
    {
      "id": "siteNav",
      "type": "container",
      "config": {
        "tag": "nav",
        "ariaLabel": "Navegación principal",
        "classes": "siteNav",
        "components": [
          "navHome",
          "navMenu",
          "navImpact",
          "navWholesale",
          "navQuestions"
        ],
        "styles": {
          "display": "flex",
          "alignItems": "center",
          "justifyContent": "space-between",
          "gap": "0",
          "minHeight": "44px",
          "paddingBottom": "0",
          "overflowX": "auto"
        }
      }
    },
