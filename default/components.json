{
  "version": 1,
  "domain": "somosgreenstock.mx",
  "pageId": "default",
  "components": [
    {
      "id": "homeMain",
      "type": "container",
      "config": {
        "id": "main-content",
        "tag": "main",
        "classes": "pageMain",
        "styles": {
          "fontFamily": "Montserrat, Arial, sans-serif"
        },
        "components": [
          "homeHero",
          "homeSteps",
          "homeCatalog",
          "homeProcess",
          "homeImpact",
          "homeWholesale",
          "homeQuestions",
          "homeFinal"
        ]
      }
    },
    {
      "id": "homeHero",
      "type": "container",
      "config": {
        "tag": "section",
        "ariaLabelledby": "homeHeroTitle",
        "classes": "ank-width-100per ank-minHeight-78vh ank-display-grid ank-gridTemplateColumns-1fr ank-gridTemplateColumns-md-0_9fr__1_1fr ank-bg-titleColor",
        "components": [
          "homeHeroCopy",
          "homeHeroMediaFrame"
        ]
      }
    },
    {
      "id": "homeHeroCopy",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "ank-display-flex ank-flexDirection-column ank-justifyContent-center ank-alignItems-start ank-gap-20px ank-paddingInline-22px ank-paddingInline-md-7vw ank-paddingBlock-64px",
        "components": [
          "homeBrandAccent",
          "homeHeroEyebrow",
          "homeHeroTitle",
          "homeHeroDescription",
          "homeHeroActions"
        ]
      }
    },
    {
      "id": "homeHeroEyebrow",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.hero.eyebrow",
      "config": {
        "tag": "p",
        "text": "Frutas y verduras listas para licuar",
        "classes": "ank-m-0 ank-color-secondaryAccentColor ank-fontSize-0_78rem ank-fontWeight-900 ank-letterSpacing-0_12em ank-textTransform-uppercase"
      }
    },
    {
      "id": "homeHeroTitle",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.hero.title",
      "config": {
        "id": "homeHeroTitle",
        "tag": "h1",
        "text": "Tu mezcla diaria ya está lista.",
        "classes": "ank-m-0 ank-maxWidth-12ch ank-color-bgColor ank-fontSize-2_7rem ank-fontSize-md-5_4rem ank-fontWeight-900 ank-lineHeight-0_92 ank-letterSpacing-MIN0_05em"
      }
    },
    {
      "id": "homeHeroDescription",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.hero.description",
      "config": {
        "tag": "p",
        "text": "Porciones congeladas y empacadas al vacío con ingredientes listos para preparar una bebida de 250 ml.",
        "classes": "ank-m-0 ank-maxWidth-54ch ank-color-secondaryBgColor ank-fontSize-1_08rem ank-fontSize-md-1_25rem ank-lineHeight-1_62"
      }
    },
    {
      "id": "homeHeroActions",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "actionRow",
        "components": [
          "homeHeroOrder",
          "homeHeroMenu"
        ]
      }
    },
    {
      "id": "homeHeroOrder",
      "type": "link",
      "valueInstructions": "set:config.href,var,ctaTargets.orderUrl;set:config.text,i18n,page.hero.primary",
      "config": {
        "href": "https://www.instagram.com/greens.tock/",
        "text": "Pide ahora",
        "ariaLabel": "Pedir Greenstock por Instagram",
        "target": "_blank",
        "rel": "noopener noreferrer",
        "classes": "primaryCta"
      }
    },
    {
      "id": "homeHeroMenu",
      "type": "link",
      "valueInstructions": "set:config.text,i18n,page.hero.secondary",
      "config": {
        "href": "/menu",
        "text": "Ver menú",
        "classes": "secondaryCta ank-borderColor-secondaryAccentColor ank-color-bgColor"
      }
    },
    {
      "id": "homeHeroMediaFrame",
      "type": "container",
      "config": {
        "tag": "figure",
        "classes": "ank-m-0 ank-minHeight-420px ank-overflow-hidden ank-bg-secondaryBgColor",
        "components": [
          "homeHeroImage"
        ]
      }
    },
    {
      "id": "homeHeroImage",
      "type": "media",
      "valueInstructions": "set:config.src,var,heroAssets.heroImageUrl;set:config.alt,var,heroAssets.heroImageAlt",
      "config": {
        "tag": "image",
        "src": "https://assets.zoolandingpage.com.mx/somosgreenstock.mx/shared/package-photos/package-front-01.webp",
        "alt": "Porción Greenstock congelada y empacada al vacío, lista para licuar",
        "width": 1440,
        "height": 1200,
        "loading": "eager",
        "fetchPriority": "high",
        "decoding": "async",
        "sizes": "(min-width: 768px) 55vw, 100vw",
        "styles": {
          "display": "block",
          "width": "100%",
          "height": "100%",
          "minHeight": "420px",
          "objectFit": "cover"
        },
        "classes": "imageCover"
      }
    },
    {
      "id": "homeSteps",
      "type": "container",
      "config": {
        "tag": "section",
        "classes": "marketSectionBright",
        "components": [
          "homeStepsContent"
        ]
      }
    },
    {
      "id": "homeStepsContent",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "marketContent",
        "components": [
          "homeStepsEyebrow",
          "homeStepsTitle",
          "homeStepsIntro",
          "homeStepsGrid"
        ]
      }
    },
    {
      "id": "homeStepsEyebrow",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.steps.eyebrow",
      "config": {
        "tag": "p",
        "text": "Así de simple",
        "classes": "eyebrow"
      }
    },
    {
      "id": "homeStepsTitle",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.steps.title",
      "config": {
        "tag": "h2",
        "text": "Tres pasos entre tu congelador y tu vaso.",
        "classes": "sectionTitle"
      }
    },
    {
      "id": "homeStepsIntro",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.steps.intro",
      "config": {
        "tag": "p",
        "text": "Cada porción reúne frutas y verduras previamente preparadas.",
        "classes": "bodyLead"
      }
    },
    {
      "id": "homeStepsGrid",
      "type": "container",
      "config": {
        "tag": "ol",
        "classes": "stepGrid ank-listStyle-none ank-padding-0 ank-margin-0",
        "components": [
          "homeStepOpen",
          "homeStepLiquid",
          "homeStepBlend"
        ]
      }
    },
    {
      "id": "homeStepOpen",
      "type": "container",
      "config": {
        "tag": "li",
        "classes": "stepItem",
        "components": [
          "homeStepOpenNumber",
          "homeStepOpenTitle",
          "homeStepOpenDescription"
        ]
      }
    },
    {
      "id": "homeStepOpenNumber",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.steps.open.number",
      "config": {
        "tag": "span",
        "text": "01",
        "classes": "stepNumber"
      }
    },
    {
      "id": "homeStepOpenTitle",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.steps.open.title",
      "config": {
        "tag": "h3",
        "text": "Abre",
        "classes": "compactTitle"
      }
    },
    {
      "id": "homeStepOpenDescription",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.steps.open.description",
      "config": {
        "tag": "p",
        "text": "Saca una porción congelada y abre el empaque.",
        "classes": "bodyCopy"
      }
    },
    {
      "id": "homeStepLiquid",
      "type": "container",
      "config": {
        "tag": "li",
        "classes": "stepItem",
        "components": [
          "homeStepLiquidNumber",
          "homeStepLiquidTitle",
          "homeStepLiquidDescription"
        ]
      }
    },
    {
      "id": "homeStepLiquidNumber",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.steps.liquid.number",
      "config": {
        "tag": "span",
        "text": "02",
        "classes": "stepNumber"
      }
    },
    {
      "id": "homeStepLiquidTitle",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.steps.liquid.title",
      "config": {
        "tag": "h3",
        "text": "Agrega líquido",
        "classes": "compactTitle"
      }
    },
    {
      "id": "homeStepLiquidDescription",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.steps.liquid.description",
      "config": {
        "tag": "p",
        "text": "Completa la mezcla con el líquido de tu elección.",
        "classes": "bodyCopy"
      }
    },
    {
      "id": "homeStepBlend",
      "type": "container",
      "config": {
        "tag": "li",
        "classes": "stepItem",
        "components": [
          "homeStepBlendNumber",
          "homeStepBlendTitle",
          "homeStepBlendDescription"
        ]
      }
    },
    {
      "id": "homeStepBlendNumber",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.steps.blend.number",
      "config": {
        "tag": "span",
        "text": "03",
        "classes": "stepNumber"
      }
    },
    {
      "id": "homeStepBlendTitle",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.steps.blend.title",
      "config": {
        "tag": "h3",
        "text": "Licúa",
        "classes": "compactTitle"
      }
    },
    {
      "id": "homeStepBlendDescription",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.steps.blend.description",
      "config": {
        "tag": "p",
        "text": "Licúa, sirve una bebida de 250 ml y disfruta.",
        "classes": "bodyCopy"
      }
    },
    {
      "id": "homeCatalog",
      "type": "container",
      "config": {
        "tag": "section",
        "classes": "marketSection",
        "components": [
          "homeCatalogContent"
        ]
      }
    },
    {
      "id": "homeCatalogContent",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "marketContent",
        "components": [
          "homeCatalogEyebrow",
          "homeCatalogTitle",
          "homeCatalogDescription",
          "homeProductGrid",
          "homeCatalogLink"
        ]
      }
    },
    {
      "id": "homeCatalogEyebrow",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.catalog.eyebrow",
      "config": {
        "tag": "p",
        "text": "Seis mezclas",
        "classes": "eyebrow"
      }
    },
    {
      "id": "homeCatalogTitle",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.catalog.title",
      "config": {
        "tag": "h2",
        "text": "Un color y una combinación para cada antojo.",
        "classes": "sectionTitle"
      }
    },
    {
      "id": "homeCatalogDescription",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.catalog.description",
      "config": {
        "tag": "p",
        "text": "Conoce las seis mezclas Greenstock.",
        "classes": "bodyLead"
      }
    },
    {
      "id": "homeProductGrid",
      "type": "container",
      "loopConfig": {
        "source": "var",
        "path": "products",
        "templateId": "homeProductCardTemplate",
        "idPrefix": "homeProduct",
        "bindings": [
          {
            "to": "config.title",
            "sources": [
              "name"
            ]
          },
          {
            "to": "config.description",
            "sources": [
              "description"
            ]
          },
          {
            "to": "config.benefits",
            "sources": [
              "ingredients"
            ]
          },
          {
            "to": "config.imageSrc",
            "sources": [
              "image"
            ]
          },
          {
            "to": "config.imageAlt",
            "sources": [
              "imageAlt"
            ]
          }
        ]
      },
      "config": {
        "tag": "div",
        "classes": "productGrid",
        "components": []
      }
    },
    {
      "id": "homeProductCardTemplate",
      "type": "generic-card",
      "config": {
        "variant": "feature",
        "title": "",
        "description": "",
        "benefits": [],
        "imageSrc": "",
        "imageAlt": "",
        "imageContainerClasses": "ank-width-100per ank-height-280px ank-height-md-320px ank-overflow-hidden ank-bg-secondaryBgColor",
        "imageClasses": "ank-display-block ank-width-100per ank-height-100per ank-objectFit-cover",
        "linkLabel": "40 MXN por porción",
        "linkClasses": "ank-m-0 ank-color-titleColor ank-fontSize-0_9rem ank-fontWeight-900",
        "classes": "productCard",
        "featureTitleClasses": "compactTitle",
        "featureDescriptionClasses": "bodyCopy",
        "benefitsListClasses": "ank-listStyle-none ank-padding-0 ank-margin-0 ank-display-flex ank-flexWrap-wrap ank-gap-6px",
        "benefitItemClasses": "ank-color-linkColor ank-fontSize-0_82rem ank-fontWeight-800",
        "benefitTextClasses": "ank-color-linkColor"
      }
    },
    {
      "id": "homeCatalogLink",
      "type": "link",
      "valueInstructions": "set:config.text,i18n,page.catalog.link",
      "config": {
        "href": "/menu",
        "text": "Explorar el menú completo",
        "classes": "secondaryCta ank-width-fitContent"
      }
    },
