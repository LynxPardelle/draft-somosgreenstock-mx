    },
    {
      "id": "homeProcessVideo",
      "type": "media",
      "config": {
        "tag": "video",
        "src": "https://assets.zoolandingpage.com.mx/somosgreenstock.mx/shared/videos/greenstock-process-01.mp4",
        "alt": "",
        "classes": "videoMedia",
        "styles": {
          "width": "100%"
