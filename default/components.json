        "controls": true,
        "preload": "none",
        "autoplay": false,
        "ariaLabel": "Reproducir demostración visual de ingredientes Greenstock"
      }
    },
    {
      "id": "homeProcessCaption",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,page.process.caption",
      "config": {
        "tag": "figcaption",
        "text": "Descripción completa del video sin audio: recorrido horizontal por recipientes con piña, hierbas y otros ingredientes preparados. No contiene narración ni información adicional.",
